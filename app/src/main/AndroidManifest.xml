<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13 o más pide permiso para mostrar notificaciones (RF16) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
        No se declara CAMERA a propósito. La foto se toma con la app de cámara del
        teléfono (ACTION_IMAGE_CAPTURE) y así esta app nunca tiene acceso directo a la cámara.
    -->

    <!--
        allowBackup en false y dataExtractionRules evitan que los tokens de sesión
        se copien a respaldos en la nube o a otro teléfono.
        networkSecurityConfig prohíbe HTTP sin cifrar (en debug se permite solo hacia
        el emulador, ver src/debug/res/xml).
    -->
    <application
        android:name=".FqsApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.FamiliasQueSuman">

        <!-- singleTop para que tocar una notificación con la app abierta no cree otra pantalla -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.FamiliasQueSuman">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Recibe las notificaciones push de Firebase. No se exporta a otras apps. -->
        <service
            android:name=".push.FqsMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="fqs_avisos" />

        <!--
            Comparte con la app de cámara un archivo temporal donde guardar la foto del
            testimonio. Solo expone la carpeta de caché fotos y no se exporta.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.archivos"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/archivos_compartidos" />
        </provider>
    </application>

</manifest>
