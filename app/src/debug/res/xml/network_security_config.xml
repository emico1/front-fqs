<?xml version="1.0" encoding="utf-8"?>
<!--
    Solo para compilaciones debug. Permite HTTP sin cifrar únicamente hacia el
    backend local (10.0.2.2 es la computadora anfitriona vista desde el emulador).
    Para probar en un teléfono físico agrega aquí la IP local de tu computadora.
    Esta versión nunca llega al APK release.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
